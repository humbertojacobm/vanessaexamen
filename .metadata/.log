		//OBTENER PUNTAJE DE PUNTUALIDAD
		
		if (MINUTO_TARDANZA == 0)
		   PUNTAJE_PUNTUALIDAD =10 ;
		else if (MINUTO_TARDANZA >=1 &&  MINUTO_TARDANZA<=2)
		         PUNTAJE_PUNTUALIDAD=8 ;

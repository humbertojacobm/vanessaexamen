	void ENTRADA_DATOS () {
		
	  PROMEDIO_PONDERADO=Double.parseDouble(tFPromedio.getText()) ;
	  CATEGORIA= cBCategoria.getSelectedItem().toString();
		
	}
	
	void OBTENER_CATEGORIA() {
		
		switch (CATEGORIA){	
		case"A" : 
			   PENSION_MENSUAL =550 ;
			   break;
		case"B" :
			   PENSION_MENSUAL=500 ;
			  break;
		case"C" :
			   PENSION_MENSUAL=460;
			  break;
		case"D": 
			   PENSION_MENSUAL =400 ; 
			   break;
			   
			 }	
	}
	
	
	void OBTENER_DESCUENTO () {
		
		if (PROMEDIO_PONDERADO>=0 && PROMEDIO_PONDERADO<=13.99) 
				   DESCUENTO=0*PENSION_MENSUAL ;
		else if (PROMEDIO_PONDERADO>=14 && PROMEDIO_PONDERADO <=15.99) 
				      DESCUENTO=0.10*PENSION_MENSUAL;
		else if (PROMEDIO_PONDERADO>=16 && PROMEDIO_PONDERADO<=17.99 )
				         DESCUENTO=0.12* PENSION_MENSUAL ;
		else if (PROMEDIO_PONDERADO>=18 && PROMEDIO_PONDERADO<=20.00 )
				           DESCUENTO=0.15* PENSION_MENSUAL;
	}
	
	void obtener_nueva_pension () {
		
		NUEVA_PENSION= (PENSION_MENSUAL-DESCUENTO);
	}
	 
	void mostrar_resultado() {
		textArea.setText("MONTO DEL DESCUENTO: "+ DESCUENTO +"/n");
		textArea.append(" NUEVA PENSION:  "+ NUEVA_PENSION );
	

	}
	
	public void actionPerformed(ActionEvent e) {
		if (e.getSource() == btNCalcular) {
			
	
			actionPerformedBtNCalcular(e);
		}
	}
	protected void actionPerformedBtNCalcular(ActionEvent e) {
		
		ENTRADA_DATOS();
		OBTENER_CATEGORIA();
		OBTENER_DESCUENTO() ;
		obtener_nueva_pension();
	 this.mostrar_resultado();
		
		 
	}

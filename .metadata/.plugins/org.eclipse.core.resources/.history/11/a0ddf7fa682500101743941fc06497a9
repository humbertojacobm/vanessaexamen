	protected void actionPerformedBtnprocesar(ActionEvent e) {
		//DECLARACION DE VARIABLES

				double SUELDO=0.00;

		 

				//ENTRADA DE DATOS

				SUELDO = Double.parseDouble(tfsueldo.getText());

		 

				//PROCESO

				if(SUELDO <= 2500)

					CANTIDAD_SUELDOS1++;

				else if(SUELDO > 2500 && SUELDO <= 3000)


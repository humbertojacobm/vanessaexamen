	public void actionPerformed(ActionEvent e) {
		if (e.getSource() == btnNewButton) {
			actionPerformedBtnNewButton(e);
		}
	}
	protected void actionPerformedBtnNewButton(ActionEvent e) {
		
		//DECLARACION DE VARIABLES 
		
		String tipoChocolate ;
		int    cantidadChocolate , CantidadCaramelosObsequios ;
		double  descuento, precioUnitario , importeCompra , importePagar ;
		
		//ENTRADA DE DATOS 
		
		tipoChocolate = this.cBtipochocolate.getSelectedItem().toString() ;
		cantidadChocolate =Integer.parseInt(this.tFcantidaddechocolate.toString()) ;
		
		importeCompra=this.traerimportecompra(tipoChocolate, cantidadChocolate);
		 descuento=this.Calcularimportedescuento(cantidadChocolate,tipoChocolate ) ;
		 importePagar= this.traerimportepagar(importeCompra, descuento);
		 CantidadCaramelosObsequios=this.traercantidadcaramelos(importePagar);
		 this.Resultados(String.valueOf(importeCompra), String.valueOf(descuento),String.valueOf(importePagar) , String.valueOf(CantidadCaramelosObsequios) );
		
		
	}
	
	
	double traerprecioUnitario (String tipochocolate) {
		double preciounitario=0 ;
		switch (tipochocolate) {
			case "PRIMOR":
				preciounitario=8.5;
				break;
			case "DULZURA":
			    preciounitario=10.0;
			    break;
			case "TENTACION":
		    preciounitario= 7.0;
		        break; 
			case "EXPLOSION":
		    preciounitario= 12.5;
		        break; 
		}
		 return preciounitario ;
		    
	}
	
	
	double Calcularimportedescuento(int cantidadchocolates,String tipochocolate ) {
		double descuento ;
		if (cantidadchocolates <5)
		              descuento=0.04 * cantidadchocolates*this.traerprecioUnitario(tipochocolate );
		else if (cantidadchocolates >= 5 &&  cantidadchocolates < 10)
			 descuento=0.065*cantidadchocolates*this.traerprecioUnitario(tipochocolate );     
		else if (cantidadchocolates >= 10 &&  cantidadchocolates < 15)
			 descuento=0.09*cantidadchocolates*this.traerprecioUnitario(tipochocolate );   	
		else 
			 descuento=0.115*cantidadchocolates*this.traerprecioUnitario(tipochocolate ); 
		 return descuento ;
	}
	
	double traerimportecompra (String tipochocolate  , int cantidad) {
		double importecompra=0;
		importecompra=cantidad*this.traerprecioUnitario(tipochocolate);
		return importecompra;
		
	}	
	double traerimportepagar(double importecompra, double importedescuento) {
		double importepagar=0 ;
		importepagar=importecompra-importedescuento ;
		return importepagar ;
		
	}
	 
	int traercantidadcaramelos( double importepagar ) {
		int cantidadcaramelos =0 ;
		if (importepagar>= 2.5)
			cantidadcaramelos= 3;
		else 
			cantidadcaramelos= 2;
		return cantidadcaramelos;
	}
	void Resultados(String  IMPORTE_COMPRA, String DESCUENTO ,String IMPORTE_PAGAR , String OBSEQUIO ) {

		this.txtresultado.setText("Importe de Compra: " + IMPORTE_COMPRA + "\n");

		this.txtresultado.append("Importe de Descuento: " + DESCUENTO + "\n");

		this.txtresultado.append("Importe a pagar: " + IMPORTE_PAGAR + "\n");

		this.txtresultado.append("Cantidad de obsequios: " + OBSEQUIO + "\n");

